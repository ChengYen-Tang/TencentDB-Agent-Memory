# Required: your OpenAI-compatible LLM credential.
TDAI_LLM_API_KEY=sk-replace-me

# Optional LLM settings.
TDAI_LLM_BASE_URL=https://api.openai.com/v1
TDAI_LLM_MODEL=gpt-4o
# TDAI_LLM_REASONING_EFFORT=medium

# The gateway is local-only by default. Use 0.0.0.0 only when you intentionally
# need LAN/internet access, and configure TDAI_GATEWAY_API_KEY at the same time.
TDAI_GATEWAY_BIND_ADDRESS=127.0.0.1
TDAI_GATEWAY_HOST_PORT=8420
# TDAI_GATEWAY_API_KEY=replace-with-a-long-random-secret
