# Docker Compose 常用設定：複製成 .env 後修改，再執行 docker compose up -d --build。
# .env 含有密鑰，請勿提交或分享。

# ── 對外入口 ──
# 執行 Docker 的主機 IP 或 DNS 名稱；不可使用 0.0.0.0 或 127.0.0.1 給其他電腦連線。
TDAI_PUBLIC_HOST=172.30.1.251
TDAI_PANEL_HOST_PORT=8123
TDAI_PROXY_HOST_PORT=8317
TDAI_KNOWLEDGE_HOST_PORT=8421
# 預設監聽所有介面；如需限制來源，可改成 127.0.0.1 或指定主機介面 IP。
# TDAI_PANEL_BIND_ADDRESS=0.0.0.0
# TDAI_PROXY_BIND_ADDRESS=0.0.0.0
# TDAI_KNOWLEDGE_BIND_ADDRESS=0.0.0.0
# 若使用不同網域、HTTPS 或反向代理，可分別指定完整網址覆蓋自動產生的位址。
# TDAI_PROXY_EXTERNAL_URL=https://proxy.example.com
# TDAI_KNOWLEDGE_EXTERNAL_URL=https://knowledge.example.com/v3

# ── MemoryCore / Wiki 內部 LLM ──
TDAI_INTERNAL_LLM_BASE_URL=https://api.openai.com/v1
TDAI_INTERNAL_LLM_API_KEY=sk-replace-me
TDAI_INTERNAL_LLM_MODEL=gpt-4o
# 可選：none / minimal / low / medium / high / xhigh / max；依模型支援情況而定。
# TDAI_INTERNAL_LLM_REASONING_EFFORT=medium
# LLM 單次輸出 token 上限，同時套用 MemoryCore 和 Wiki，不等於 context window。
# 未設定時沿用 MemoryCore/tdai-gateway.standalone.yaml 的 llm.maxTokens。
# TDAI_INTERNAL_LLM_MAX_TOKENS=258000
# TDAI_INTERNAL_LLM_TIMEOUT_MS=120000
# TDAI_KNOWLEDGE_LLM_TIMEOUT_MS=1200000

# ── Codex 專用的上游 LLM（模型與推理強度在 Codex 自己設定）──
CODEX_LLM_BASE_URL=https://api.openai.com/v1
CODEX_LLM_API_KEY=sk-replace-me

# ── Wiki 向量搜尋（需要 OpenAI 相容的 embedding 服務）──
# 預設 bm25；改為 vector 或 hybrid 時，須設定 embedding 位址與模型。
# KNOWLEDGE_WIKI_SEARCH_MODE=hybrid
# KNOWLEDGE_EMBEDDING_BASE_URL=http://embedding-host:8000/v1
# KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
# KNOWLEDGE_EMBEDDING_API_KEY=

# ── 服務間認證 ──
# 設為長且隨機的字串；這不是 LLM key，也不是 Web 登入用的 User Key。
TDAI_GATEWAY_API_KEY=replace-with-a-long-random-secret

# ── Azure Repos ──
# 自簽憑證預設不驗證；設為 true 可啟用驗證。
# CODE_SOURCE_AZURE_DEVOPS_VERIFY_TLS=false
# 內網 Git 位址若遭 SSRF 保護阻擋，可在可信網路中設為 off。
# KNOWLEDGE_SSRF_CHECK=off
