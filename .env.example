# Required internal LLM account. It is used by MemoryCore and Wiki ingestion,
# never by Codex user traffic.
TDAI_INTERNAL_LLM_BASE_URL=https://api.openai.com/v1
TDAI_INTERNAL_LLM_API_KEY=sk-replace-me
TDAI_INTERNAL_LLM_MODEL=gpt-4o
# TDAI_INTERNAL_LLM_REASONING_EFFORT=medium

# Required Codex traffic account. It is used only by memory-proxy.
CODEX_LLM_BASE_URL=https://api.openai.com/v1
CODEX_LLM_API_KEY=sk-replace-me

# Required internal service secret; this is not an LLM provider API key.
TDAI_GATEWAY_API_KEY=replace-with-a-long-random-secret
