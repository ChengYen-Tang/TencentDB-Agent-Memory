# docker-compose.yml — one-command local deployment with separate LLM accounts.
#
# These values are passed only to tdai-gateway. They are used for MemoryCore's
# own memory extraction / summarisation work and never enter the proxy container.
TDAI_INTERNAL_LLM_BASE_URL=https://api.openai.com/v1
TDAI_INTERNAL_LLM_API_KEY=sk-replace-me
TDAI_INTERNAL_LLM_MODEL=gpt-4o
# TDAI_INTERNAL_LLM_REASONING_EFFORT=medium

# These values are passed only to memory-proxy. They are used only for requests
# received at /codex/<spaceId>/..., and replace Codex's sk-mem-* identity key
# before the request goes to the provider.
CODEX_LLM_BASE_URL=https://api.openai.com/v1
CODEX_LLM_API_KEY=sk-replace-me

# Set the same long random value on both containers. This protects the local
# Gateway API; it is not an LLM provider API key.
TDAI_GATEWAY_API_KEY=replace-with-a-long-random-secret
TDAI_SERVICE_ID=default

# Both ports are loopback-only by default. Change a bind address only when a
# reverse proxy/auth layer is intentionally in front of the service.
TDAI_GATEWAY_BIND_ADDRESS=127.0.0.1
TDAI_GATEWAY_HOST_PORT=8420
TDAI_PROXY_BIND_ADDRESS=127.0.0.1
TDAI_PROXY_HOST_PORT=8096

# The URL put into Codex's memory/skill tool recipes. Keep it in sync with the
# proxy port above; set a public reverse-proxy URL when Codex runs elsewhere.
TDAI_PROXY_EXTERNAL_URL=http://127.0.0.1:8096
